# Copy this file to .env for local runs. Never commit real credentials.

# --- UXPilot ---
# Account email is read per project from Google Sheet -> UX Pilot Account.
# The same fixed password is used for all UXPilot accounts.
UXPILOT_SHARED_PASSWORD=

# Backward-compatible fallback names (optional).
UX_EMAIL=
UX_PASSWORD=

# --- Elementor converter ---
# Account email is read per project from Google Sheet -> CONV Elementor Account.
# The same fixed password is used for all converter accounts.
ELEMENTOR_SHARED_PASSWORD=
ELEMENTOR_PASSWORD=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1bJFab0nXnV2mTzR2nAVl5V6Aqb7ajz1diAV6fwpID0k

# --- Email ---
RESEND_API_KEY=
ADMIN_EMAIL=emad_1382@yahoo.com

# --- Static phase-1 target URLs ---
FIGMA_URL=https://www.figma.com/design/NLkFc0NtOqUnR9Fh6madRL/ENGAR-KE
ELEMENTOR_URL=https://web2elementor.com/html-to-elementor/

# --- Phase-2 AI defaults ---
# Per-project AI Token Account is read from Google Sheet.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=5000
